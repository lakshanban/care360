PORT=4000
CORS_ORIGIN=http://localhost:3000
FUNCTION_REGION=us-central1
# MongoDB (default matches local single-node; DB name via MONGODB_DB if URI has no /dbname)
MONGODB_URI=mongodb://localhost:27017/?directConnection=true&ssl=false
MONGODB_DB=care360
# Set only if the API runs in Docker and must use hostname "mongo":
# MONGODB_SKIP_HOST_REWRITE=1
# Disable directConnection in driver (default: on for localhost URIs):
# MONGODB_DIRECT_CONNECTION=0
# Optional; dev fallback exists in code
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars
# Seed password for admin@care360.local (only when DB has no users)
SEED_ADMIN_PASSWORD=Care360Admin!

# --- AWS S3 (caregiver registration uploads; presigned PUT/GET) ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
# Optional; omit on AWS/Lambda if using instance/task role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Presign TTL (seconds)
# S3_PRESIGN_PUT_EXPIRES=900
# S3_PRESIGN_GET_EXPIRES=3600
# Max upload size validated at presign (bytes)
# S3_MAX_UPLOAD_BYTES=10485760
#
# Bucket CORS (example): allow PUT/POST/GET from your app origin for browser uploads.
